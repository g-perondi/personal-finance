{
  "name": "personal-finance",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --base ./",
    "icons": "node scripts/generate-icon.mjs",
    "electron:start": "wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:start\"",
    "electron:pack": "node scripts/electron-prebuild.mjs && npm run icons && npm run build:electron",
    "electron:build": "npm run electron:build:win",
    "electron:build:win": "npm run electron:pack && electron-builder --win",
    "electron:build:mac": "npm run electron:pack && electron-builder --mac",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.personal.finance",
    "productName": "Personal Finance",
    "icon": "build/icon.png",
    "directories": {
      "output": "artifacts",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "identity": null
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{js,mjs,cjs,json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource/inconsolata": "^5.3.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^8.0.5"
  }
}
